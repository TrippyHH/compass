        "upstream_outcome_unknown": {
          "default": false,
          "title": "Upstream Outcome Unknown",
          "type": "boolean"
        },
        "upstream_request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upstream Request Id"
        },
        "usage": {
          "$ref": "#/$defs/ModelUsage"
        },
        "validation": {
          "$ref": "#/$defs/OutputValidation"
        }
      },
      "required": [
        "call_id",
        "provider_id",
        "config_version",
        "status",
        "duration_ms",
        "requested_model"
