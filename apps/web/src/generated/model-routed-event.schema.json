              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "finish_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finish Reason"
        },
        "provider_id": {
          "format": "uuid",
          "title": "Provider Id",
          "type": "string"
        },
        "requested_model": {
          "title": "Requested Model",
          "type": "string"
        },
        "response_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Model"
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "canceled",
            "incomplete"
