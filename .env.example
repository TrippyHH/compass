# 本地合成数据演示；复制为 .env。勿用于共享或生产环境。
DATABASE_URL=postgresql+psycopg://compass:compass_local_only@127.0.0.1:55432/compass
AGENT_API_URL=http://127.0.0.1:8000
# Memory 脚手架 smoke 地址；后续 Runtime 工具使用独立服务接口。
MEMORY_API_URL=http://127.0.0.1:8001
COMPASS_DEMO_ENABLED=true

# 模型接入：BFF 服务身份、凭据加密与端点允许列表。
# 三者缺失时模型接口按设计拒绝：服务身份缺失 503，加密密钥缺失不能保存或调用。
COMPASS_AGENT_SERVICE_TOKEN=compass-local-service-token-change-me
COMPASS_MODEL_ENCRYPTION_KEY=compass-local-model-key-change-me
# 精确 origin 白名单，逗号分隔；阿里云百炼 Workspace 网关需显式加入。
# 例：https://llm-<workspace-id>.cn-beijing.maas.aliyuncs.com
COMPASS_MODEL_ALLOWED_ORIGINS=https://api.deepseek.com,https://api.typesafe.ai
COMPASS_MODEL_ALLOW_LOCAL_HTTP=true

# Web 自有数据库；先运行 pnpm db:provision -F web，再运行 pnpm db:migrate -F web。
WEB_DATABASE_URL=postgresql://compass_web_runtime:compass_web_runtime_local_only@127.0.0.1:55432/compass_web
WEB_MIGRATION_DATABASE_URL=postgresql://compass_web_migrator:compass_web_migration_local_only@127.0.0.1:55432/compass_web
# 仅首次本地 provision 使用，运行服务不读取此凭据。
WEB_PROVISION_DATABASE_URL=postgresql://compass:compass_local_only@127.0.0.1:55432/compass
WEB_PUBLIC_ORIGIN=http://127.0.0.1:3000
WEB_AUTH_ALLOW_LOCAL_HTTP=true
WEB_SESSION_TTL_SECONDS=43200
# Web 开发服务就绪后自动打开登录页；设为 0 可关闭。
# WEB_DEV_OPEN_BROWSER=0
# 教学 fixture 必须显式选择；自行设置密码后执行 pnpm db:seed -F web -- --fixture teaching。
# WEB_FIXTURE_PASSWORD=
